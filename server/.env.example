# Existing application settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easydraw
JWT_SECRET=replace-me
CLIENT_URL=http://localhost:5173

# Private S3 bucket used for the shared library and user-uploaded images.
AWS_REGION=ap-southeast-2
AWS_S3_ASSETS_BUCKET=easydraw-user-assets

# Local development only. In ECS, attach an IAM task role instead of setting
# long-lived access keys in the container environment.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional limits (defaults shown).
ASSET_MAX_FILE_BYTES=10485760
ASSET_USER_QUOTA_BYTES=104857600
# Decoder limit, before resizing. One image is processed per API instance.
ASSET_MAX_IMAGE_PIXELS=16000000

# S3 setup requirements are documented in docs/custom-node-libraries.md:
# - Block Public Access enabled; bucket owner enforced; encryption enabled.
# - Browser CORS allows your CLIENT_URL for POST, GET and HEAD.
# - Lifecycle expires only pending/ objects after one day; never assets/.
# - IAM permits only this bucket's pending/, assets/, and whiteboard-previews/ prefixes.
# Keep the region/bucket empty in environments without configured S3. Uploads
# return a descriptive 503 until configured; there is no local-storage fallback.

# Whiteboard AI preview (Step 3). Server-only; never use NEXT_PUBLIC_ for secrets.
# Enable only after the preview migration and S3 preview-prefix IAM policy.
WHITEBOARD_AI_PREVIEW_ENABLED=false
# Enable only after applying the additive whiteboard_diagram_conversions migration.
WHITEBOARD_AI_COMMIT_ENABLED=false
# Keep maintenance true after deployment even if AI dispatch is later disabled.
# Leave false only until the migration has been applied.
WHITEBOARD_AI_PREVIEW_MAINTENANCE_ENABLED=false
OPENAI_API_KEY=
OPENAI_DIAGRAM_MODEL=gpt-6-sol
WHITEBOARD_AI_REQUESTS_PER_MINUTE=5
WHITEBOARD_AI_DAILY_LIMIT=20
